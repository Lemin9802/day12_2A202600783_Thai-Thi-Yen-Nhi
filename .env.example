# ── MaiThuyLaw AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in values before running locally.
# On Railway: set these in the Railway dashboard (Variables tab).

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=MaiThuyLaw AI
APP_VERSION=1.0.0
ENVIRONMENT=production
PORT=8000

# ── API Key — PUBLIC DEMO vs RESTRICTED ACCESS ────────────────────────────────
#
# PUBLIC DEMO (recommended for this product):
#   Leave MAITHUYLAW_API_KEY empty or unset.
#   The server will allow all same-origin requests without a key.
#   Protection comes from: rate limit (10 req/min) + safety guard + domain guard.
#   The React frontend does NOT need a key baked into the JS bundle.
#
#   MAITHUYLAW_API_KEY=
#
# RESTRICTED ACCESS (if you want to lock down the API):
#   Set a strong random value here AND pass VITE_MAITHUYLAW_API_KEY=<same value>
#   at Docker build time (ARG in Dockerfile or Railway build variable).
#   Note: the key will be visible in the JS bundle — it is a "public API key"
#   for rate-limiting purposes, NOT a server secret.
#
#   MAITHUYLAW_API_KEY=change-me-to-strong-random-value
#
# Default (empty = public demo mode):
MAITHUYLAW_API_KEY=

# Also accepted as fallback (legacy compatibility):
# AGENT_API_KEY=

# ── Gemini — required for AI answers ──────────────────────────────────────────
# If not set, the system falls back to retrieved-text answers (no LLM synthesis).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Rate limits ────────────────────────────────────────────────────────────────
MAITHUYLAW_RATE_LIMIT_PER_MINUTE=10
MAITHUYLAW_DAILY_LIMIT=500
MONTHLY_BUDGET_USD=10.0

# ── CORS — add your Railway URL after first deploy ────────────────────────────
# Leave empty during development (localhost is always allowed).
# Example: MAITHUYLAW_ALLOWED_ORIGINS=https://maithuylaw-ai.railway.app
MAITHUYLAW_ALLOWED_ORIGINS=

# ── Dataset path — has a built-in default, only override if needed ─────────────
# MAITHUYLAW_RAG_CHUNKS=data/maithuylaw_dataset/data/index/rag_chunks.json

# ── Realtime search — disabled by default ─────────────────────────────────────
MAITHUYLAW_REALTIME_ENABLED=false
# TAVILY_API_KEY=your-tavily-key-here
