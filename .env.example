# Day 12 final-lab application
APP_NAME=Day 12 Production Agent
APP_VERSION=1.0.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Required for protected endpoints
AGENT_API_KEY=replace-with-a-strong-key

# Shared persistence for conversation history
REDIS_URL=redis://localhost:6379/0

# Protection controls
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

# Educational mock model configuration
LLM_MODEL=mock-llm
DEBUG=false
